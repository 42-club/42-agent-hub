# Organization workspace backed by 42-agent-service. Servers bind to loopback by default.
PORT=3000
HUB_HOST=127.0.0.1
HUB_COORDINATOR_PORT=4317
# Per-agent deadline, 10,000–300,000 ms. Default: 180,000 ms.
# HUB_AGENT_TIMEOUT_MS=180000
# Model credentials can be added in the UI. They remain on the server.
# HUB_DATA_DIR=.data
# Optional: this connection will be configured at first database creation.
# OPENROUTER_API_KEY=

# Shared 42 Club backend. The Hub never owns users, organizations or a business DB.
CLUB_SERVICE_URL=http://127.0.0.1:4242/api/v1
# Optional, server-only: bypass secret from the destination Service project's
# Deployment Protection settings. Configure on Hub Preview for protected Service.
# CLUB_SERVICE_PROTECTION_BYPASS=
# Set explicitly. Sibling-file reuse is disabled unless explicitly enabled locally.
# HUB_SERVICE_TOKEN=<same independent 32+ character secret as the backend>
# HUB_LOAD_SHARED_ENV=true
# CLUB_ENV_DIR=../42-agent-service
# HUB_BUILD_DIR=.next
# HUB_STORAGE=local-test is ONLY for isolated legacy tests.

# Vercel durable execution (automatically enabled on Vercel).
# HUB_EXECUTION=workflow

# Explicit production opt-in. Leave unset for local development and Vercel Preview.
# Production Hub AND Service require this plus NODE_ENV=production;
# the database environment label must also match. See docs/runtime-reliability.md.
# HUB_DEPLOYMENT_ENV=production

# Verified registrations receive a default organization with database admission.
# Existing organizations must be imported once; see docs/organization-onboarding.md.
# Set ONLY to a header overwritten by your trusted hosting ingress. Hub signs
# attribution to Service; never trust a visitor-supplied X-Forwarded-For chain.
# HUB_TRUSTED_CLIENT_IP_HEADER=<verified-ingress-header>
